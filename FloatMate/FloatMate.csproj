<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FloatMate</AssemblyName>
    <RootNamespace>FloatMate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/xxxlibraaa-commits/desktop-helpworker.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/xxxlibraaa-commits/desktop-helpworker</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>

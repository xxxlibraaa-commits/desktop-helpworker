<UserControl x:Class="FloatMate.Controls.PlanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="PlanPageRoot" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="PlanSummaryToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PlanSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlanSurface" Property="Background" Value="#F7F8FA" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PlanSurface" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="PlanSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PlanSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="PlanSurface" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PlanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="2,0,2,14">
                <StackPanel>
                    <TextBlock Text="长期计划" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="月度、40 天或更长周期的工作进度" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}"
                        Content="＋ 新建" Click="NewPlan_Click" AutomationProperties.Name="新建长期计划" />
            </Grid>

            <Grid Margin="2,0,2,10">
                <StackPanel>
                    <TextBlock Text="计划列表" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="点击一个计划查看工作进度" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Content="导入 XLSX" Click="Import_Click"
                        ToolTip="导入 XLSX 甘特计划" AutomationProperties.Name="导入 XLSX 长期计划" />
            </Grid>

            <ItemsControl x:Name="PlanList" Margin="0,0,0,14">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource PlanSummaryToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Click="PlanSummary_Click" Tag="{Binding}" Margin="0,0,0,9"
                                      AutomationProperties.Name="{Binding Name, StringFormat=打开长期计划：{0}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RangeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular" />
                                    <Grid Margin="0,9,0,0">
                                        <ProgressBar Style="{StaticResource TaskProgressBar}" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,0,74,0" />
                                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Column="1" MinWidth="44" Height="28" Padding="8,0" Margin="12,0,0,0" CornerRadius="8"
                                        Background="{StaticResource SoftSurfaceBrush}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="展开" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="收起" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyPlanPanel" Style="{StaticResource GlassCard}" Padding="18" Visibility="Collapsed">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="期" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有长期计划" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock Text="可以直接导入现有 XLSX，也可以建立一个默认 40 天计划。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PlanContent" Visibility="Collapsed">
                <Border Style="{StaticResource GlassCard}" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" Margin="0,0,64,0"
                                     BorderThickness="0" Padding="0,2" Background="Transparent" LostKeyboardFocus="PlanField_LostFocus"
                                     AutomationProperties.Name="计划名称" />
                            <Button x:Name="ExportButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="导出" Click="Export_Click"
                                    ToolTip="导出当前计划为 XLSX" AutomationProperties.Name="导出当前长期计划为 XLSX" />
                        </Grid>
                        <TextBlock x:Name="PlanSourceText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始日期" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" SelectedDateChanged="PlanDate_Changed" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结束日期" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" SelectedDateChanged="PlanDate_Changed" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <TextBlock x:Name="PlanProgressText" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock x:Name="PlanRangeText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <ProgressBar x:Name="PlanProgressBar" Style="{StaticResource TaskProgressBar}" Height="7" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="工作进度" Style="{StaticResource SectionTitle}" />
                        <Border Background="#F2F2F7" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                            <TextBlock x:Name="PlanTaskCountText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Content="＋ 任务" Click="AddTask_Click" AutomationProperties.Name="添加长期计划任务" />
                </Grid>

                <Border Background="#F7F7F9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="11" Padding="11,8" Margin="0,0,0,12">
                    <TextBlock Text="拖动蓝色时间条可整体移动；拖动两端可调整起止日期。所有调整按天吸附并自动保存。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                </Border>

                <Border x:Name="EmptyTasksPanel" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="这个计划还没有任务" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="添加任务后即可安排日期、进度和状态。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoActiveTasksPanel" Background="#F7F7F9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                        CornerRadius="11" Padding="13,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="未完成任务已清空，完成记录收在下方。" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </Border>

                <ItemsControl x:Name="PlanTasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold"
                                                 BorderThickness="0" Padding="0,2" Background="Transparent" LostKeyboardFocus="TaskField_LostFocus"
                                                 AutomationProperties.Name="任务名称" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ElementName=PlanPageRoot, Path=StatusOptions}" SelectedItem="{Binding Status, Mode=TwoWay}"
                                                  SelectionChanged="TaskStatus_Changed" Height="32" Margin="8,0,0,0" AutomationProperties.Name="任务状态" />
                                    </Grid>
                                    <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                        <Button HorizontalAlignment="Right" Content="安排" Click="ScheduleTask_Click" Tag="{Binding}" Padding="8,3" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsScheduled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <Canvas Width="326" Height="30" Margin="0,4,0,0" ClipToBounds="True"
                                            PreviewMouseMove="TimelineCanvas_MouseMove" PreviewMouseLeftButtonUp="TimelineCanvas_MouseUp">
                                        <Border Canvas.Top="11" Width="326" Height="8" Background="#F2F2F7" BorderBrush="#C7C7CC" BorderThickness="1" CornerRadius="4" />
                                        <Border Canvas.Top="9" Height="12" Width="{Binding TimelineWidth}" Canvas.Left="{Binding TimelineLeft}"
                                                CornerRadius="5" Tag="{Binding}"
                                                PreviewMouseLeftButtonDown="TimelineBar_MouseDown" Cursor="SizeAll">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsScheduled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="已完成"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="暂停"><Setter Property="Background" Value="#7B7B82" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Border Width="8" Background="#38FFFFFF" HorizontalAlignment="Left" Tag="{Binding}" PreviewMouseLeftButtonDown="TimelineStart_MouseDown" Cursor="SizeWE" />
                                                <Border Width="8" Background="#38FFFFFF" HorizontalAlignment="Right" Tag="{Binding}" PreviewMouseLeftButtonDown="TimelineEnd_MouseDown" Cursor="SizeWE" />
                                            </Grid>
                                        </Border>
                                    </Canvas>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="进度" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Progress, Mode=TwoWay}"
                                                ValueChanged="TaskProgress_Changed" Margin="10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0}%}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <Expander Header="编辑负责人、分类与日期" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0">
                                        <StackPanel Margin="0,9,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="分类" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,0,4" /><TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="TaskField_LostFocus" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="负责人" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,0,4" /><TextBox Text="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="TaskField_LostFocus" /></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="开始日期" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,0,4" /><DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" SelectedDateChanged="TaskDate_Changed" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="结束日期" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,0,0,4" /><DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" SelectedDateChanged="TaskDate_Changed" /></StackPanel>
                                            </Grid>
                                            <TextBlock Text="备注" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,9,0,4" />
                                            <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top" LostKeyboardFocus="TaskField_LostFocus" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="CompletedTasksExpander" IsExpanded="False" Visibility="Collapsed" Margin="0,2,0,16">
                    <Expander.Header>
                        <Grid MinHeight="34">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CompletedTasksHeaderText" Text="已完成" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="默认收起" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0" />
                        </Grid>
                    </Expander.Header>
                    <ItemsControl x:Name="CompletedTasksList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F8FA" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="102" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding ElementName=PlanPageRoot, Path=StatusOptions}" SelectedItem="{Binding Status, Mode=TwoWay}"
                                                  SelectionChanged="TaskStatus_Changed" Height="30" Margin="8,0,0,0" AutomationProperties.Name="已完成任务状态" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="FloatMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FloatMate.Controls"
        Title="浮岛 FloatMate"
        Width="420" Height="760" MinWidth="336" MinHeight="190"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Deactivated="Window_Deactivated" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="浮岛桌面助手">
    <Border x:Name="WindowFrame" Background="#F2FFFFFF" CornerRadius="26"
            BorderBrush="#B8D1D1D6" BorderThickness="1" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.20" Color="#585860" />
        </Border.Effect>

        <Grid>
            <Grid x:Name="MiniView" Visibility="Collapsed" Margin="17,14,17,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Ellipse Grid.RowSpan="3" Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-112,-75,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2E7DBBFF" Offset="0" />
                            <GradientStop Color="#0C7DBBFF" Offset="0.58" />
                            <GradientStop Color="#007DBBFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="18" /></Ellipse.Effect>
                </Ellipse>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="20" Height="20" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" BorderBrush="#B6D7F5" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="F" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FLOATMATE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="WidgetModeText" Text="桌面组件" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="32" Style="{StaticResource IconButton}" Click="ToggleView_Click" ToolTip="打开详细面板 (Ctrl+Shift+Space)" AutomationProperties.Name="打开浮岛详细面板" Content="•••" FontSize="13" Padding="4,1" Background="#E7E7EC" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="MiniTitle" Text="今天，从一条轨道开始" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MiniSubtitle" Text="系统良好" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        <ProgressBar x:Name="MiniProgressBar" Height="4" Maximum="100" Value="0" Margin="0,10,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="11,8">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="CPU" Foreground="{StaticResource SubtleBrush}" FontSize="11" />
                                <TextBlock x:Name="MiniCpuText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="MEM" Foreground="{StaticResource SubtleBrush}" FontSize="11" />
                                <TextBlock x:Name="MiniMemoryText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="MiniGoalText" Text="0/0 目标" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                        <TextBlock x:Name="MiniWaterText" Text="0 ml" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="42" Height="28" Style="{StaticResource IconButton}" Tag="起身" Click="QuickRecord_Click" ToolTip="记录起身" AutomationProperties.Name="记录一次起身活动" Content="起身" FontSize="11" Padding="3,2" Background="#EDEDF2" />
                        <Button Width="52" Height="28" Style="{StaticResource IconButton}" Click="QuickWater_Click" ToolTip="记录喝水 250 ml" AutomationProperties.Name="记录喝水二百五十毫升" Content="＋ 水" FontSize="11" Padding="3,2" Margin="5,0,0,0" Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="FullView" Margin="20,17,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" BorderBrush="#B6D7F5" BorderThickness="1" Margin="0,0,11,0">
                            <TextBlock Text="F" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AppTitleText" Text="浮岛" FontSize="20" FontWeight="SemiBold" />
                                <Border Background="#E9F5EC" BorderBrush="#C7E6CE" BorderThickness="1" CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LocalBadgeText" Text="LOCAL" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TodayText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="FullCollapseButton" Width="34" Height="34" Style="{StaticResource IconButton}" Click="ToggleView_Click" Content="⌄" ToolTip="收起为小组件" AutomationProperties.Name="收起为桌面小组件" FontSize="19" Background="#E7E7EC" />
                        <Button x:Name="FullHideButton" Width="34" Height="34" Style="{StaticResource IconButton}" Click="Hide_Click" Content="—" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到系统托盘" FontSize="16" Background="#E7E7EC" Margin="7,0,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#E8E8ED" BorderBrush="#D9D9DE" BorderThickness="1" CornerRadius="13" Padding="3" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TodayNavButton" Grid.Column="0" Style="{StaticResource SegmentedActiveButton}" Content="今天" Click="ShowToday_Click" AutomationProperties.Name="今天" Padding="8,8" />
                        <Button x:Name="PlanNavButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="计划" Click="ShowPlan_Click" AutomationProperties.Name="长期工作计划" Padding="8,8" />
                        <Button x:Name="UsageNavButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="使用" Click="ShowUsage_Click" AutomationProperties.Name="今日应用使用时间" Padding="8,8" />
                        <Button x:Name="HistoryNavButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="复盘" Click="ShowHistory_Click" AutomationProperties.Name="历史复盘" Padding="8,8" />
                        <Button x:Name="SettingsNavButton" Grid.Column="4" Style="{StaticResource IconButton}" Content="设置" Click="ShowSettings_Click" AutomationProperties.Name="设置" Padding="8,8" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                <ScrollViewer x:Name="TodayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="HealthDot" Width="8" Height="8" CornerRadius="5" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border.Effect><DropShadowEffect Color="#34C759" BlurRadius="5" ShadowDepth="0" Opacity="0.28" /></Border.Effect>
                                        </Border>
                                        <TextBlock Text="系统健康" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Border x:Name="HealthBadge" Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="HealthText" Text="正在读取" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SoftCard}" Padding="9,8" Margin="0,0,4,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource SubtleBrush}" FontSize="11" /><TextBlock x:Name="CpuText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,3,0,0" /></StackPanel></Border>
                                    <Border Grid.Column="1" Style="{StaticResource SoftCard}" Padding="9,8" Margin="2,0"><StackPanel><TextBlock Text="内存" Foreground="{StaticResource SubtleBrush}" FontSize="11" /><TextBlock x:Name="MemoryText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,3,0,0" /></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="9,8" Margin="2,0"><StackPanel><TextBlock Text="磁盘" Foreground="{StaticResource SubtleBrush}" FontSize="11" /><TextBlock x:Name="DiskText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,3,0,0" /></StackPanel></Border>
                                    <Border Grid.Column="3" Style="{StaticResource SoftCard}" Padding="9,8" Margin="4,0,0,0"><StackPanel><TextBlock Text="下载" Foreground="{StaticResource SubtleBrush}" FontSize="11" /><TextBlock x:Name="NetworkText" Text="-- K" Style="{StaticResource MetricValue}" Margin="0,3,0,0" /></StackPanel></Border>
                                </Grid>
                                <TextBlock x:Name="SystemDetailText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="今日轨道" Style="{StaticResource SectionTitle}" />
                                <Border Background="#F2F2F7" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="GoalCountText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="ShowAddGoal_Click" Content="＋ 新目标" AutomationProperties.Name="添加新的今日目标" FontSize="13" />
                        </Grid>

                        <Border x:Name="AddGoalPanel" Visibility="Collapsed" Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="2,0,2,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="目标名称" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="预计用时" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="GoalInput" KeyDown="GoalInput_KeyDown" MaxLength="120" AutomationProperties.Name="目标名称" AutomationProperties.HelpText="输入今天要完成的目标" />
                                    <ComboBox x:Name="GoalEstimateCombo" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="2" AutomationProperties.Name="目标预计用时">
                                        <ComboBoxItem Content="25 分" Tag="25"/><ComboBoxItem Content="45 分" Tag="45"/><ComboBoxItem Content="60 分" Tag="60"/><ComboBoxItem Content="90 分" Tag="90"/><ComboBoxItem Content="120 分" Tag="120"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="详细工作内容（可选）" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,10,0,6" />
                                <TextBox x:Name="GoalDetailsInput" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" MaxLength="2000" KeyDown="GoalDetailsInput_KeyDown"
                                         AutomationProperties.Name="详细工作内容" AutomationProperties.HelpText="输入步骤、交付物、注意事项或下一步" />
                                <Grid Margin="2,8,0,0">
                                    <TextBlock Text="可记录步骤、交付物或注意事项；Ctrl + Enter 添加" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Content="添加目标" Click="AddGoal_Click" AutomationProperties.Name="确认添加目标" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="EmptyGoalsPanel" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" Margin="0,0,11,0">
                                    <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="今天还没有轨道" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="创建一个足够具体、今天能完成的下一步" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="创建" Click="ShowAddGoal_Click" AutomationProperties.Name="创建第一个目标" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="GoalsList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid Margin="15,14,14,11">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="GoalStateDot" Width="6" Height="6" CornerRadius="3" Background="#7B7B82" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="15,7,0,0">
                                                        <TextBlock x:Name="GoalStateText" Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="  ·  " Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding FocusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                        <TextBlock Text="  ·  " Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding EstimateText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                    </StackPanel>
                                                    <Grid Margin="15,8,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="GoalDetailsText" Text="{Binding DetailsPreview}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                                   LineHeight="19" TextWrapping="Wrap" MaxHeight="42" VerticalAlignment="Center" />
                                                        <Button x:Name="GoalDetailsEditButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="{Binding DetailsActionText}"
                                                                Tag="{Binding}" Click="GoalDetailsEdit_Click" FontSize="11" Padding="7,4" Margin="8,0,0,0"
                                                                AutomationProperties.Name="添加或编辑详细工作内容" VerticalAlignment="Top" />
                                                    </Grid>
                                                    <Border x:Name="GoalDetailsEditor" Visibility="Collapsed" Background="#F7F7F9" BorderBrush="{StaticResource SeparatorBrush}"
                                                            BorderThickness="1" CornerRadius="11" Padding="9" Margin="15,9,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="详细工作内容" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6" />
                                                            <TextBox Text="{Binding EditingDetails, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                     MinHeight="72" MaxHeight="150" VerticalScrollBarVisibility="Auto" MaxLength="2000"
                                                                     KeyDown="GoalDetailsEditor_KeyDown" AutomationProperties.Name="编辑详细工作内容"
                                                                     AutomationProperties.HelpText="按 Ctrl 加 Enter 保存，按 Escape 取消" />
                                                            <Grid Margin="2,8,0,0">
                                                                <TextBlock Text="Ctrl + Enter 保存" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Style="{StaticResource IconButton}" Content="取消" Tag="{Binding}" Click="GoalDetailsCancel_Click" Padding="8,5" AutomationProperties.Name="取消编辑工作内容" />
                                                                    <Button Style="{StaticResource SecondaryButton}" Content="保存" Tag="{Binding}" Click="GoalDetailsSave_Click" Padding="10,5" Margin="6,0,0,0" AutomationProperties.Name="保存详细工作内容" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Button x:Name="GoalActionButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding ActionText}" IsEnabled="{Binding CanStart}" Tag="{Binding}" Click="GoalStart_Click" AutomationProperties.Name="开始或暂停目标计时" FontSize="12" Padding="12,6" VerticalAlignment="Top" />
                                            </Grid>
                                            <Grid Grid.Row="1" Background="#F5F5F8" Margin="1,0,1,1">
                                                <Grid Margin="15,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <ProgressBar x:Name="GoalProgressBar" Style="{StaticResource TaskProgressBar}"
                                                                     Value="{Binding Progress}"
                                                                     Maximum="100"
                                                                     VerticalAlignment="Center"
                                                                     AutomationProperties.Name="任务完成进度" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource TabularLabel}" MinWidth="30" TextAlignment="Right" Margin="9,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" Content="−" Tag="{Binding}" Click="GoalProgressDecrease_Click" ToolTip="进度减少 10%" AutomationProperties.Name="目标进度减少百分之十" FontSize="13" />
                                                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" Content="＋" Tag="{Binding}" Click="GoalProgress_Click" ToolTip="进度增加 10%" AutomationProperties.Name="目标进度增加百分之十" FontSize="13" />
                                                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" Content="✓" Tag="{Binding}" Click="GoalComplete_Click" ToolTip="完成 / 恢复" AutomationProperties.Name="完成或恢复目标" FontSize="12" />
                                                        <Button Width="30" Height="30" Style="{StaticResource IconButton}" Content="×" Tag="{Binding}" Click="GoalDelete_Click" ToolTip="删除，可在五秒内撤销" AutomationProperties.Name="删除目标" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter TargetName="GoalStateDot" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="GoalStateText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                            <Setter TargetName="GoalDetailsText" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditingDetails}" Value="True">
                                            <Setter TargetName="GoalDetailsText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="GoalDetailsEditButton" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="GoalDetailsEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter TargetName="GoalStateDot" Property="Background" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="GoalStateText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="GoalProgressBar" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="GoalActionButton" Property="Background" Value="#DCDCE2" />
                                            <Setter TargetName="GoalActionButton" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="快速记录" Style="{StaticResource SectionTitle}" Margin="2,6,0,12" />
                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Button Style="{StaticResource QuickActionButton}" Click="QuickWater_Click" AutomationProperties.Name="记录喝水二百五十毫升" Margin="0,0,5,0">
                                <StackPanel><Border Width="28" Height="28" CornerRadius="9" Background="#EFEFF3" HorizontalAlignment="Center"><TextBlock Text="水" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Text="喝水" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="250 ml" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Tag="如厕" Click="QuickRecord_Click" AutomationProperties.Name="记录一次如厕" Margin="2.5,0">
                                <StackPanel><Border Width="28" Height="28" CornerRadius="9" Background="#EFEFF3" HorizontalAlignment="Center"><TextBlock Text="厕" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Text="如厕" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="记录一次" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Tag="起身" Click="QuickRecord_Click" AutomationProperties.Name="记录一次起身活动" Margin="2.5,0">
                                <StackPanel><Border Width="28" Height="28" CornerRadius="9" Background="#EFEFF3" HorizontalAlignment="Center"><TextBlock Text="起" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Text="起身" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="记录一次" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickActionButton}" Tag="护眼" Click="QuickRecord_Click" AutomationProperties.Name="记录一次护眼休息" Margin="5,0,0,0">
                                <StackPanel><Border Width="28" Height="28" CornerRadius="9" Background="#EFEFF3" HorizontalAlignment="Center"><TextBlock Text="眼" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Text="护眼" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="远眺 20 秒" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" /></StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Background="#F7F7F9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="11" Padding="10,8" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WaterStatText" Grid.Column="0" Style="{StaticResource TabularLabel}" TextAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource SeparatorBrush}" />
                                <TextBlock x:Name="ToiletStatText" Grid.Column="2" Style="{StaticResource TabularLabel}" TextAlignment="Center" />
                                <Border Grid.Column="3" Background="{StaticResource SeparatorBrush}" />
                                <TextBlock x:Name="StandStatText" Grid.Column="4" Style="{StaticResource TabularLabel}" TextAlignment="Center" />
                                <Border Grid.Column="5" Background="{StaticResource SeparatorBrush}" />
                                <TextBlock x:Name="EyeStatText" Grid.Column="6" Style="{StaticResource TabularLabel}" TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassCard}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" Opacity="0.7" />
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="今天的小结" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="RecordCountText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </Grid>
                                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="21" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="导出" Style="{StaticResource SectionTitle}" Margin="2,18,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCard}" Padding="13">
                                <StackPanel>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="工" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="工作" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="任务、详细内容、进度与专注时长" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,10" />
                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource SecondaryButton}" Content="XLSM" Click="ExportWorkXlsm_Click" Margin="0,0,3,0" Padding="8,6"
                                                ToolTip="导出今日工作表格" AutomationProperties.Name="导出今日工作为 XLSM" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="DOCX" Click="ExportWorkDocx_Click" Margin="3,0,0,0" Padding="8,6"
                                                ToolTip="导出今日工作日报" AutomationProperties.Name="导出今日工作为 DOCX" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="13">
                                <StackPanel>
                                    <Border Width="30" Height="30" CornerRadius="9" Background="#EFEFF3" HorizontalAlignment="Left">
                                        <TextBlock Text="健" Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="健康" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" />
                                    <TextBlock Text="总次数、总量与每次发生时间" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,10" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="XLSX 表格" Click="ExportHealthXlsx_Click" Padding="8,6"
                                            ToolTip="导出今日健康汇总和明细" AutomationProperties.Name="导出今日健康记录为 XLSX 表格" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="DataLocationText" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ScrollViewer>

                <controls:PlanPage x:Name="PlanView" Visibility="Collapsed" />

                <ScrollViewer x:Name="UsageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="2,0,2,14">
                            <StackPanel>
                                <TextBlock Text="应用使用" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="今天的前台活跃时间" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="UsageCountText" Text="暂无数据" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Typography.NumeralAlignment="Tabular" />
                        </Grid>

                        <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="今日活跃" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="UsageTotalText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Typography.NumeralAlignment="Tabular" AutomationProperties.Name="今日应用总使用时间" />
                                <TextBlock x:Name="UsageTopAppText" Text="从现在开始累计今天的前台活跃时间"
                                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20" />
                                <Border Background="#F2F2F7" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,13,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="UsageTrackingText" Grid.Column="1" Text="正在本机统计" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="今天的应用" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />

                        <Border x:Name="EmptyUsagePanel" Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Width="36" Height="36" CornerRadius="11" Background="#F2F2F7" HorizontalAlignment="Left">
                                    <TextBlock Text="时" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="暂时还没有应用记录" FontSize="14" FontWeight="SemiBold" Margin="0,11,0,0" />
                                <TextBlock Text="切换到其他应用并开始工作后，这里会逐步出现使用时间。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19" />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="UsageList" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassCard}" Padding="13" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="#F2F2F7" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource TaskProgressBar}"
                                                         Value="{Binding Share}" Maximum="100" Margin="9,10,0,0" Height="5"
                                                         AutomationProperties.Name="相对使用时长" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#F7F7F9" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <TextBlock Text="仅记录应用名称与累计时长，不保存窗口标题或文档内容。连续无操作 5 分钟后暂停统计；本功能从启用后开始累计。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="HistoryScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="2,0,2,12">
                            <StackPanel>
                                <TextBlock Text="历史复盘" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="所有记录独立保存，可按天查看" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="HistoryDateCombo" HorizontalAlignment="Right" Width="128" Height="32" SelectionChanged="HistoryDateCombo_SelectionChanged" />
                        </Grid>

                        <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="当日概览" Style="{StaticResource SectionTitle}" Margin="0,0,0,7" />
                                <TextBlock x:Name="HistorySummaryText" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="21" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="时间线" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
                                        <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Icon}" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="11,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHistoryText" Text="这一天还没有记录" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,28,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="提醒系统" FontSize="19" FontWeight="SemiBold" Margin="2,0,0,3" />
                        <TextBlock Text="提醒通过 Windows 通知显示，完成对应记录后重新计时" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,12" TextWrapping="Wrap" />

                        <Border Style="{StaticResource GlassCard}" Padding="13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox x:Name="WaterReminderCheck" Content="喝水提醒" Click="ReminderSetting_Changed" /><TextBlock Text="上次喝水后重新计算" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,4,0,0" /></StackPanel>
                                <ComboBox x:Name="WaterIntervalCombo" Grid.Column="1" Width="88" SelectionChanged="ReminderSetting_Changed"><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="45 分钟" Tag="45"/><ComboBoxItem Content="60 分钟" Tag="60"/><ComboBoxItem Content="90 分钟" Tag="90"/></ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GlassCard}" Padding="13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox x:Name="StandReminderCheck" Content="久坐提醒" Click="ReminderSetting_Changed" /><TextBlock Text="记录起身后重新计算" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,4,0,0" /></StackPanel>
                                <ComboBox x:Name="StandIntervalCombo" Grid.Column="1" Width="88" SelectionChanged="ReminderSetting_Changed"><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="45 分钟" Tag="45"/><ComboBoxItem Content="50 分钟" Tag="50"/><ComboBoxItem Content="60 分钟" Tag="60"/></ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GlassCard}" Padding="13" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox x:Name="EyeReminderCheck" Content="护眼提醒" Click="ReminderSetting_Changed" /><TextBlock Text="记录护眼后重新计算" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="26,4,0,0" /></StackPanel>
                                <ComboBox x:Name="EyeIntervalCombo" Grid.Column="1" Width="88" SelectionChanged="ReminderSetting_Changed"><ComboBoxItem Content="20 分钟" Tag="20"/><ComboBoxItem Content="25 分钟" Tag="25"/><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="45 分钟" Tag="45"/></ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="桌面行为" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
                        <Border Style="{StaticResource GlassCard}" Padding="14">
                            <StackPanel>
                                <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动" Click="StartupCheck_Click" />
                                <CheckBox x:Name="DockedRightModeCheck" Content="固定在屏幕左侧并预留工作区" IsChecked="True" Margin="0,12,0,0" Click="DesktopSetting_Changed" AutomationProperties.HelpText="让最大化应用和桌面图标避开助手占用的左侧区域" />
                                <TextBlock Text="Windows 会把助手作为左侧 AppBar 管理，最大化窗口和桌面文件不会进入这块区域。" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="27,5,0,0" />
                                <CheckBox x:Name="DesktopWidgetModeCheck" Content="桌面小组件模式（普通软件会覆盖浮岛）" Margin="0,12,0,0" Click="DesktopSetting_Changed" />
                                <CheckBox x:Name="AutoCollapseCheck" Content="失去焦点后自动收起，不遮挡工作窗口" IsChecked="True" Margin="0,12,0,0" Click="DesktopSetting_Changed" />
                                <TextBlock Text="透明度" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,15,0,5" />
                                <Slider x:Name="OpacitySlider" Minimum="0.86" Maximum="1" Value="0.94" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />
                                <TextBlock Text="左侧停靠会持续显示并占用工作区；桌面小组件模式不会压住普通窗口；两者都关闭时则作为置顶悬浮工具。独占全屏游戏或播放器可能由系统暂时覆盖。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="ToastPanel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12,0,12,14" Padding="11,8"
                        Background="#FAFFFFFF" BorderBrush="#B8C8DCF0" BorderThickness="1" CornerRadius="12"
                        Visibility="Collapsed" Panel.ZIndex="30" AutomationProperties.LiveSetting="Polite">
                    <Border.Effect><DropShadowEffect Color="#505058" BlurRadius="18" ShadowDepth="5" Opacity="0.22" /></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="UndoDeleteButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="撤销" Click="UndoDelete_Click" AutomationProperties.Name="撤销删除目标" FontSize="12" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" Padding="8,4" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

